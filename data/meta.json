   "formula": "f(x) =\\sum\\limits_{k=0}^\\infty\n  \\frac{e^{-\\lambda/2}(\\lambda/2)^k}\n  { B\\left(\\frac{\\nu_2}{2},\\frac{\\nu_1}{2}+k\\right) k!}\n  \\left(\\frac{\\nu_1}{\\nu_2}\\right)^{\\frac{\\nu_1}{2}+k}\n  \\left(\\frac{\\nu_2}{\\nu_2+\\nu_1x}\\right)\n  ^{\\frac{\\nu_1+\\nu_2}{2}+k}x^{\\nu_1/2-1+k}\n  \\ \\ \\ \\ \\mathrm{for\\ } x > 0",
   "mean_str": "\\frac{\\nu_2(\\nu_1 + \\lambda)}{\\nu_1(\\nu_2-2)}",
   "variance_str": "2\\frac{(\\nu_1+\\lambda)^2+(\\nu_1+2\\lambda)(\\nu_2-2)}{(\\nu_2-2)^2(\\nu_2-4)} \\left(\\frac{\\nu_2}{\\nu_1}\\right)^2",
   "range": {
    "min": 0.0,
    "max": 100.0,
